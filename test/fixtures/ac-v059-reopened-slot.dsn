(PCB "PCB2"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "EasyEDA Pro")
    (host_version "4.1.78")
  )
  (resolution mil 1000)
  (structure
    (boundary(path signal 0 0 0 0 1000 1200 1000 1200 0 0 0 )
    )
    (via via0
    )
    (grid via   0.25)
    (grid wire   0.25)
    (grid place   0.25)
    (rule(clear 6.03))
    (rule(clear 6.03 (type default_smd)))
    (rule(clear 6.03 (type smd_smd)))
    (rule(width 10.05))
    (layer TopLayer
      (type signal)
    )
    (layer Inner1
      (type signal)
    )
    (layer Inner2
      (type signal)
    )
    (layer BottomLayer
      (type signal)
    )
  
    (plane "ACE_VIA" (polygon "Inner1" 0 296 104 103.99999999999994 104 104 196 296.0000000000001 196 296 104))
    (plane "+5V" (polygon "Inner1" 0 896 504 604 504 604 696 896 696 896 504))
  )

  (placement
    (component u1
      (place u1 0 0 front 0
      )
    )
  )
  (library
    (image u1
      (pin p51611a06d79522747 51611a06d79522747 229.66 300)
      (pin p51611a06d79522747 51611a06d79522748 170.34 300)
      (pin p3b6f628633b0709d7 3b6f628633b0709d7 929.66 300)
