    )
    (padstack p3577d6c78f47fc5b
      (shape(circle TopLayer 24 0 0))
      (shape(circle Inner1 24 0 0))
      (shape(circle Inner2 24 0 0))
      (shape(circle BottomLayer 24 0 0))
    )
    (padstack p21abb4263d4bd871
      (shape(polygon TopLayer 0.1 -67.5 -22.5 -67.5 22.5 -67.5 22.5 67.5 22.5 67.5 22.5 67.5 -22.5 67.5 -22.5 -67.5 -22.5))
      (shape(polygon Inner1 0.1 -67.5 -22.5 -67.5 22.5 -67.5 22.5 67.5 22.5 67.5 22.5 67.5 -22.5 67.5 -22.5 -67.5 -22.5))
      (shape(polygon Inner2 0.1 -67.5 -22.5 -67.5 22.5 -67.5 22.5 67.5 22.5 67.5 22.5 67.5 -22.5 67.5 -22.5 -67.5 -22.5))
      (shape(polygon BottomLayer 0.1 -67.5 -22.5 -67.5 22.5 -67.5 22.5 67.5 22.5 67.5 22.5 67.5 -22.5 67.5 -22.5 -67.5 -22.5))
    )
  )
  (network
