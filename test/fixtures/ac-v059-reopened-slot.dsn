      (pin p21abb4263d4bd871 21abb4263d4bd871 757.5 177.5)
    )

    (padstack via0
      (shape(circle TopLayer 24))
      (shape(circle Inner1 24))
      (shape(circle Inner2 24))
      (shape(circle BottomLayer 24))
    )

    (padstack p51611a06d79522747
      (shape(polygon TopLayer 0.1 -15.88 -17.01 -15.88 17.01 -15.88 17.01 15.88 17.01 15.88 17.01 15.88 -17.01 15.88 -17.01 -15.88 -17.01))
    )
    (padstack p3b6f628633b0709d7
