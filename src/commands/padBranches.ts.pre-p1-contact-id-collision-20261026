import type { ICommandDef } from '../engine/types';
import type { TuneContact, TuneLine } from '../pcb/lengthTuneTargets';
import type { BranchArcContact, BranchContact, BranchCapsuleContact } from '../pcb/branchContactGeometry';
import type { PadBranchesRequest } from '../pcb/padBranchGeometry';
